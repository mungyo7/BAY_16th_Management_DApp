# BAY 16기 관리 시스템 - 환경 변수 설정
# 
# 이 파일을 .env로 복사하고 실제 값으로 채워주세요.
# cp .env.example .env

# ============================================
# Supabase 설정
# ============================================

# Supabase 프로젝트 URL
# https://app.supabase.com/project/{project-id}/settings/api 에서 확인
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (공개 가능)
# 클라이언트 측에서 사용하는 공개 키
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (비밀 유지 필수!)
# 서버 측에서만 사용, RLS 우회 가능
# 절대로 클라이언트나 공개 저장소에 노출하지 마세요
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Solana 설정 (선택사항)
# ============================================

# Solana RPC 엔드포인트
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=https://api.devnet.solana.com  # 개발용

# Solana 프로그램 ID (BAY 토큰/NFT 관련)
SOLANA_PROGRAM_ID=your-program-id-here

# ============================================
# 애플리케이션 설정
# ============================================

# 애플리케이션 포트
PORT=3000

# 환경 설정 (development, staging, production)
NODE_ENV=development

# API 기본 URL
API_BASE_URL=http://localhost:3000

# CORS 허용 도메인 (쉼표로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# 보안 설정
# ============================================

# JWT 시크릿 (선택사항 - 자체 인증 구현시)
JWT_SECRET=your-jwt-secret-here

# API Rate Limiting (요청/분)
RATE_LIMIT_PER_MINUTE=100

# ============================================
# 로깅 설정
# ============================================

# 로그 레벨 (error, warn, info, debug)
LOG_LEVEL=info

# 로그 파일 경로
LOG_FILE_PATH=./logs/app.log

# ============================================
# 이메일 설정 (선택사항)
# ============================================

# SMTP 설정 (회원 알림용)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# 발신자 정보
EMAIL_FROM_NAME=BAY 16기
EMAIL_FROM_ADDRESS=noreply@bay16.com

# ============================================
# 기타 설정
# ============================================

# 현재 학기 (예: 2025-1)
CURRENT_SEMESTER=2025-1

# 기본 포인트 보상 설정
DEFAULT_ATTENDANCE_POINTS=10
DEFAULT_LATE_POINTS=5

# 파일 업로드 설정
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ============================================
# 개발 도구 설정
# ============================================

# 디버그 모드
DEBUG=false

# 테스트 모드 (테스트시 실제 트랜잭션 방지)
TEST_MODE=false

# ============================================
# 주의사항
# ============================================
# 
# 1. 이 파일을 복사하여 .env 파일을 생성하세요
# 2. .env 파일은 절대 Git에 커밋하지 마세요
# 3. Service Role Key는 서버에서만 사용하세요
# 4. 프로덕션 환경에서는 모든 키를 안전하게 관리하세요
# 5. 환경별로 다른 설정 파일을 사용하세요 (.env.development, .env.production)
#